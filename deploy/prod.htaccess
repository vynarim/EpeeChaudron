# Site L'Épée et le Chaudron — déposé sur l'hébergement sous le nom .htaccess,
# à la racine www/. Envoyé par scripts/deploy.sh : le modifier ici, jamais sur
# le serveur, sinon le prochain envoi écrase la modification.

RewriteEngine On

# 1. Tout le site en HTTPS. Le service worker et l'installation comme
#    application n'existent qu'en HTTPS. Sur l'hébergement mutualisé OVH, le
#    port est le seul indicateur fiable.
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 2. Les adresses de l'ancien site (jusqu'en septembre 2026) mènent à la
#    section qui les remplace : liens des partenaires, favoris, résultats de
#    recherche. NE : ne pas encoder le # de l'ancre. Cible écrite en entier :
#    relative, Apache y ajoute « :443 » derrière le proxy d'OVH.
RewriteRule ^personnages\.html$  https://%{HTTP_HOST}/#personnages   [R=301,NE,L]
RewriteRule ^animations\.html$   https://%{HTTP_HOST}/#animations    [R=301,NE,L]
RewriteRule ^vie-de-camp\.html$  https://%{HTTP_HOST}/#animations    [R=301,NE,L]
RewriteRule ^materiel\.html$     https://%{HTTP_HOST}/#organisateurs [R=301,NE,L]
RewriteRule ^contact\.html$      https://%{HTTP_HOST}/#contact       [R=301,NE,L]
RewriteRule ^galerie/            https://%{HTTP_HOST}/#galerie       [R=301,NE,L]
RewriteRule ^(association|agenda|liens)\.html$ https://%{HTTP_HOST}/ [R=301,L]

# 3. L'ancien répertoire de recette /v2/ renvoie à la racine. Seul v2/sw.js
#    reste servi : il désinscrit le service worker de la recette chez les
#    membres qui l'avaient ouverte (voir deploy/v2-sw.js).
RewriteCond %{REQUEST_URI} !^/v2/sw\.js$
RewriteRule ^v2(/(.*))?$ https://%{HTTP_HOST}/$2 [R=301,L]

# 3 ter. /costumes/ : adresse courte de la page d'analyse des costumes, pour
#    les membres seulement (voir deploy/costumes/index.html). Sans la barre
#    finale, la cible est écrite en entier pour la même raison qu'en 2.
RewriteRule ^costumes$ https://%{HTTP_HOST}/costumes/ [R=301,L]

# 3 bis. www/supprimer/ reçoit ce qui attend d'être effacé à la main (restes
#    de l'ancien site et de la recette) : jamais servi.
RewriteRule ^supprimer(/|$) - [F,L]

# 4. Ne pas servir les fichiers de configuration eux-mêmes.
<FilesMatch "^\.(htaccess|htpasswd)$">
  Require all denied
</FilesMatch>

# 5. Type MIME du manifeste : Apache ne connaît pas .webmanifest par défaut,
#    et un manifeste servi en text/plain n'est pas toujours accepté.
AddType application/manifest+json .webmanifest

# 6. Le service worker ne doit jamais être servi depuis un cache ancien,
#    sinon une correction peut mettre des jours à atteindre les visiteurs.
<Files "sw.js">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</Files>

# 7. Aucun script exécuté côté serveur. Le site n'en a pas besoin : un fichier
#    PHP ou CGI déposé par un pirate ne doit jamais tourner, ni même être lu.
<FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|asp|aspx|jsp)$">
  Require all denied
</FilesMatch>
Options -Indexes

# 8. Consignes de sécurité données au navigateur.
#    - Content-Security-Policy : la page n'accepte que ses propres fichiers.
#      Un script ou une redirection injectés depuis un autre site ne
#      s'exécutent pas. Le site n'a ni script ni style écrit dans la page :
#      ne pas en ajouter, ils seraient bloqués (mettre le code dans assets/).
#    - frame-ancestors / X-Frame-Options : personne ne peut afficher le site
#      dans un cadre pour tromper le visiteur.
#    - nosniff : un fichier est lu pour ce qu'il déclare être.
#    - Strict-Transport-Security : le navigateur ne repasse jamais en http.
#      Un an ; sans includeSubDomains, pour ne rien imposer aux adresses mail.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # /costumes/ ne doit apparaître dans aucun moteur de recherche. Pas de
  # Disallow dans robots.txt : il signalerait l'adresse à qui le lit, et un
  # robot interdit d'entrée ne verrait jamais cette consigne.
  SetEnvIf Request_URI "^/costumes(/|$)" EC_NOINDEX
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" env=EC_NOINDEX
</IfModule>
